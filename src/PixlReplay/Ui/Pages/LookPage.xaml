<UserControl x:Class="PixlReplay.Ui.Pages.LookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PixlReplay.Ui"
             xmlns:e="clr-namespace:PixlReplay.Ui.Edit">
    <UserControl.Resources>
        <!-- A ready-made theme: a small window in its colors, ringed in the accent when it is the one in use -->
        <Style x:Key="ThemeTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="118">
                            <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="11" Padding="2">
                                <Border Height="70" CornerRadius="8" Background="{Binding BackgroundBrush}" ClipToBounds="True">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- side bar, a card, a button -->
                                        <Border CornerRadius="4" Background="{Binding SurfaceBrush}" Margin="0,0,6,0"/>
                                        <Border Grid.Column="1" CornerRadius="5" Background="{Binding SurfaceBrush}" Padding="7,5">
                                            <StackPanel>
                                                <TextBlock Text="Aa" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" FlowDirection="LeftToRight"/>
                                                <Border Height="8" Width="34" CornerRadius="4" Background="{Binding AccentBrush}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       x:Name="Name"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T look.title}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Sub}" Text="{l:T look.subtitle}" Margin="0,0,0,18"/>

        <!-- Ready-made themes -->
        <Border Style="{StaticResource Card}" Padding="20,16,8,4">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T look.cardThemes}"/>
                <ItemsControl ItemsSource="{Binding LookThemes}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ThemeTile}" Command="{Binding ChooseCommand}" AutomationProperties.Name="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The three colors everything else is made from -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T look.cardColors}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="{l:T look.accent}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T look.accentTip}"/>
                    </StackPanel>
                    <e:ColourRow Grid.Column="1" GroupName="lookAccent" Swatches="{Binding AccentSwatches}" Colour="{Binding AccentHex}"
                                 VerticalAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T look.accent}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="{l:T look.background}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T look.backgroundTip}"/>
                    </StackPanel>
                    <e:ColourRow Grid.Column="1" GroupName="lookBackground" Swatches="{Binding BackgroundSwatches}" Colour="{Binding BackgroundHex}"
                                 VerticalAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T look.background}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T look.text}" Margin="0,0,16,0"/>
                    <e:ColourRow Grid.Column="1" GroupName="lookText" Swatches="{Binding TextSwatches}" Colour="{Binding TextHex}"
                                 VerticalAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T look.text}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Font and size -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T look.cardFont}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T look.font}" Margin="0,0,16,0"/>
                    <!-- Each font named in itself; hundreds of them, so the list draws only what is in view -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LookFonts}" SelectedItem="{Binding LookFont}" MaxDropDownHeight="360"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                              AutomationProperties.Name="{l:T look.font}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="{l:T look.size}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T look.sizeTip}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="80" Maximum="140" Value="{Binding LookSize, Delay=120}" IsSnapToTickEnabled="True" TickFrequency="5"
                            VerticalAlignment="Center" AutomationProperties.Name="{l:T look.size}"/>
                    <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{Binding LookSize, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- A picture behind the window -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T look.cardPicture}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{Binding LookPictureText}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Command="{Binding ChoosePictureCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LookPictureButton}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="{l:T look.pictureRemove}" Command="{Binding RemovePictureCommand}"
                            Margin="8,0,0,0" Visibility="{Binding LookHasPicture, Converter={StaticResource Vis}}"/>
                </Grid>
                <StackPanel Visibility="{Binding LookHasPicture, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T look.pictureDim}" Margin="0,0,16,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="95" Value="{Binding LookDim}" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" AutomationProperties.Name="{l:T look.pictureDim}"/>
                        <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding LookDim, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T look.pictureBlur}" Margin="0,0,16,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="40" Value="{Binding LookBlur}" IsSnapToTickEnabled="True" TickFrequency="2"
                                VerticalAlignment="Center" AutomationProperties.Name="{l:T look.pictureBlur}"/>
                        <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding LookBlur, Mode=OneWay}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" Text="{l:T look.panels}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T look.panelsTip}"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding LookPanels}" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" AutomationProperties.Name="{l:T look.panels}"/>
                        <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding LookPanels, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Command="{Binding ResetLookCommand}" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T look.reset}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
